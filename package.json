{
  "name": "@adaptive-ds/lexware",
  "version": "0.1.0",
  "scripts": {
    "build": "rm -rf ./dist && bun tsc -p ./tsconfig.lib.json",
    "check": "bunx tsgo --noEmit",
    "format": "biome format --write .",
    "test": "bun test",
    "test:w": "bun test --watch",
    "release": "bash ./ops/release.sh",
    "update": "bun update",
    "clean": "rm -rf ./dist",
    "reset": "rm -rf ./node_modules"
  },
  "peerDependencies": {
    "@adaptive-ds/result": "^0.6.0",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.8",
    "@types/bun": "^1.3.13",
    "typescript": "^6.0.3"
  },
  "imports": {
    "#result": "@adaptive-ds/result"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "type": "module",
  "main": "dist/index.js",
  "private": false,
  "license": "MIT",
  "description": "TypeScript Result-based API clients for Lexware Office.",
  "keywords": [
    "lexware",
    "lexware-office",
    "api-client",
    "typescript",
    "result"
  ],
  "homepage": "https://github.com/david1gp/lexware",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david1gp/lexware.git"
  },
  "bugs": {
    "url": "https://github.com/david1gp/lexware/issues"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ]
}
